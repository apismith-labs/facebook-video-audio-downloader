# Copy to .env and fill in your own token. .env is git-ignored.
APIFY_TOKEN=your_apify_token_here

# Actor used as the resolver backend. Keep the default unless you run your own copy.
APIFY_ACTOR_ID=apple_yang/facebook-transcript-scraper-api

# Pinned Build. The clients verify buildNumber and buildId on every Run.
APIFY_BUILD=0.0.18

# Per-Run charge cap in USD. A Run costs $0.0055 for a video under one minute.
APIFY_MAX_TOTAL_CHARGE_USD=0.10

# Set to 1 to refuse to create a Run when no cap is configured.
APIFY_REQUIRE_MAX_TOTAL_CHARGE_USD=0

# Set to 1 in tests and CI so a developer's .env can never trigger a paid Run.
APIFY_SKIP_DOTENV=0
